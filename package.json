{
  "name": "smarthub-agrochain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run db:generate && npm run typecheck && npm test && npm run verify:syntax && npm run verify:foundation",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/release/require-migration-url.mjs && prisma migrate deploy",
    "verify:foundation": "node scripts/check-foundation.mjs",
    "verify:syntax": "node scripts/check-syntax.mjs",
    "verify:public-runtime": "node scripts/check-public-runtime.mjs",
    "verify:integration-config": "node scripts/release/audit-integration-config.mjs",
    "verify:deployment-env": "node scripts/release/check-environment.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.16.3",
    "zod": "4.1.12",
    "server-only": "0.0.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
