// Phase 11. Recorded physical lots are distinct from harvest estimates and approved declarations.
// "AVAILABLE" means eligible verified physical supply, not warehouse ownership or fulfilled inventory.
enum SupplyLotStatus {
  AVAILABLE
  ON_HOLD
}
enum OrderStatus {
  PENDING_PAYMENT
  CANCELLED
  EXPIRED
  PAYMENT_VERIFIED
  PAYMENT_REVIEW
  FULFILLING
  COMPLETED
}
enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}
enum StockMovementKind {
  RECEIVED
  RESERVED
  RELEASED
  CONSUMED
}

model SupplyLot {
  id               String @id @default(uuid()) @db.Uuid
