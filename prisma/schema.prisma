  handlingNote String? @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  createdBy   Account @relation("FulfillmentPlanCreator",fields:[createdById],references:[id],onDelete:Restrict)
  shipments   Shipment[]
  @@index([status,updatedAt])
  @@map("fulfillment_plans")
}

model Shipment {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  reference    String @unique @db.VarChar(40)
  status       ShipmentStatus @default(PLANNED)
  carrierName  String @db.VarChar(160)
  carrierContact String? @db.VarChar(80)
  vehicleNote  String? @db.VarChar(160)
  trackingReference String? @db.VarChar(120)
  pickupAt     DateTime?
  dispatchAt   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plan         FulfillmentPlan @relation(fields:[planId],references:[id],onDelete:Restrict)
  lines        ShipmentLine[]
  events       DeliveryEvent[]
  evidence     ShipmentEvidence[]
  receipt      ReceiptConfirmation?
  issue        DeliveryIssue?
  @@index([planId,status,createdAt])
  @@map("shipments")
}

model ShipmentLine {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @db.Uuid
  orderLineId String @db.Uuid
  quantity    Decimal @db.Decimal(18,3)
  shipment    Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
  orderLine   OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
  receiptLine ReceiptLine?
  @@unique([shipmentId,orderLineId])
  @@index([orderLineId])
  @@map("shipment_lines")
}

model DeliveryEvent {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @db.Uuid
  actorId     String @db.Uuid
  kind        DeliveryEventKind
  note        String? @db.VarChar(2000)
  evidenceId  String? @unique @db.Uuid
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
  actor       Account @relation("ShipmentEventActor",fields:[actorId],references:[id],onDelete:Restrict)
  evidence    ShipmentEvidence? @relation("ShipmentEventEvidence",fields:[evidenceId],references:[id],onDelete:Restrict)
  @@index([shipmentId,createdAt])
  @@map("delivery_events")
}

model ShipmentEvidence {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @db.Uuid
  uploadedById String @db.Uuid
  objectPath  String @unique @db.VarChar(500)
  originalName String @db.VarChar(180)
  contentType String @db.VarChar(80)
  sizeBytes   Int
  status      ShipmentEvidenceStatus @default(UPLOADING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shipment    Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
  uploadedBy  Account @relation("ShipmentEvidenceUploader",fields:[uploadedById],references:[id],onDelete:Restrict)
  event       DeliveryEvent? @relation("ShipmentEventEvidence")
  @@index([shipmentId,status,createdAt])
  @@map("shipment_evidence")
}

model ReceiptConfirmation {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @unique @db.Uuid
  buyerId     String @db.Uuid
  status      ReceiptStatus
  note        String? @db.VarChar(2000)
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
  buyer       Account @relation("ReceiptBuyer",fields:[buyerId],references:[id],onDelete:Restrict)
  lines       ReceiptLine[]
  @@index([buyerId,createdAt])
  @@map("receipt_confirmations")
}

model ReceiptLine {
  id             String @id @default(uuid()) @db.Uuid
  receiptId      String @db.Uuid
  shipmentLineId String @unique @db.Uuid
  acceptedQuantity Decimal @db.Decimal(18,3)
  shortageQuantity Decimal @db.Decimal(18,3)
  receipt        ReceiptConfirmation @relation(fields:[receiptId],references:[id],onDelete:Restrict)
  shipmentLine   ShipmentLine @relation(fields:[shipmentLineId],references:[id],onDelete:Restrict)
  @@index([receiptId])
  @@map("receipt_lines")
}

model DeliveryIssue {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @unique @db.Uuid
  reportedById String @db.Uuid
  reviewedById String? @db.Uuid
  status      DeliveryIssueStatus @default(OPEN)
  category    String @db.VarChar(40)
  description String @db.VarChar(2000)
  reviewNote  String? @db.VarChar(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shipment    Shipment @relation(fields:[shipmentId],references:[id],onDelete:Restrict)
  reportedBy  Account @relation("DeliveryIssueReporter",fields:[reportedById],references:[id],onDelete:Restrict)
  reviewedBy  Account? @relation("DeliveryIssueReviewer",fields:[reviewedById],references:[id],onDelete:SetNull)
  @@index([status,createdAt])
  @@map("delivery_issues")
}


// Phase 14 — farmer-specific contract terms and independently reconciled outward transfers.
// Buyer quote prices are not supplier prices; delivery completion is not payout settlement.
enum SupplierAgreementStatus {
  PROPOSED
  ACCEPTED
  DECLINED
}
enum SupplierObligationStatus {
  PENDING_APPROVAL
  APPROVED
  TRANSFER_PENDING
  REVIEW_REQUIRED
  SETTLED
}
enum SupplierTransferStatus {
  INITIATING
  UNKNOWN
  PENDING
  FAILED
  VERIFIED
  REVIEW_REQUIRED
}
enum SupplierReconciliationOutcome {
  PENDING
  FAILED
  VERIFIED
  MISMATCH
  LATE_REVIEW
}
enum PayoutAccountStatus {
  VERIFIED
  BLOCKED
}

model FarmerPayoutAccount {
 id String @id @default(uuid()) @db.Uuid
 farmerId String @unique @db.Uuid
 bankCode String @db.VarChar(12)
 accountName String @db.VarChar(160)
 accountLast4 String @db.VarChar(4)
 encryptedNumber String @db.VarChar(300)
 fingerprint String @db.VarChar(64)
 version Int @default(1)
 status PayoutAccountStatus @default(VERIFIED)
 verifiedAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 farmer Account @relation("FarmerPayoutAccountOwner",fields:[farmerId],references:[id],onDelete:Restrict)
 @@map("farmer_payout_accounts")
}

model SupplierAgreement {
 id String @id @default(uuid()) @db.Uuid
 orderLineId String @unique @db.Uuid
 farmerId String @db.Uuid
 proposedById String @db.Uuid
 unitPriceNgn Decimal @db.Decimal(16,2)
 currency String @default("NGN") @db.VarChar(3)
 status SupplierAgreementStatus @default(PROPOSED)
 version Int @default(1)
 note String @db.VarChar(2000)
 acceptedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orderLine OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
 farmer Account @relation("SupplierAgreementFarmer",fields:[farmerId],references:[id],onDelete:Restrict)
 proposedBy Account @relation("SupplierAgreementProposer",fields:[proposedById],references:[id],onDelete:Restrict)
 obligation SupplierObligation?
 @@index([farmerId,status,createdAt])
 @@map("supplier_agreements")
}

model SupplierObligation {
 id String @id @default(uuid()) @db.Uuid
 orderLineId String @unique @db.Uuid
 agreementId String @unique @db.Uuid
 farmerId String @db.Uuid
 quantity Decimal @db.Decimal(18,3)
 amountMinor BigInt
 currency String @default("NGN") @db.VarChar(3)
 status SupplierObligationStatus @default(PENDING_APPROVAL)
 approvedById String? @db.Uuid
 approvedAt DateTime?
 bankFingerprint String? @db.VarChar(64)
 bankVersion Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orderLine OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
 agreement SupplierAgreement @relation(fields:[agreementId],references:[id],onDelete:Restrict)
 farmer Account @relation("SupplierObligationFarmer",fields:[farmerId],references:[id],onDelete:Restrict)
 approvedBy Account? @relation("SupplierObligationApprover",fields:[approvedById],references:[id],onDelete:SetNull)
 attempts SupplierSettlementAttempt[]
 @@index([farmerId,status,createdAt])
 @@index([status,createdAt])
 @@map("supplier_obligations")
}

model SupplierSettlementAttempt {
 id String @id @default(uuid()) @db.Uuid
 obligationId String @db.Uuid
 initiatedById String @db.Uuid
 reference String @unique @db.VarChar(50)
 status SupplierTransferStatus @default(INITIATING)
 recipientCode String? @db.VarChar(100)
 recipientBankCode String @db.VarChar(12)
 recipientEncryptedNumber String @db.VarChar(300)
 recipientFingerprint String @db.VarChar(64)
 recipientAccountName String @db.VarChar(160)
 providerTransferId String? @unique @db.VarChar(50)
 verifiedAt DateTime?
 lastCheckedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 obligation SupplierObligation @relation(fields:[obligationId],references:[id],onDelete:Restrict)
 initiatedBy Account @relation("SettlementInitiator",fields:[initiatedById],references:[id],onDelete:Restrict)
 reconciliations SupplierSettlementReconciliation[]
 @@index([obligationId,status,createdAt])
 @@map("supplier_settlement_attempts")
}

model SupplierSettlementReconciliation {
 id String @id @default(uuid()) @db.Uuid
 attemptId String @db.Uuid
 actorId String? @db.Uuid
 trigger String @db.VarChar(20)
 outcome SupplierReconciliationOutcome
 providerStatus String @db.VarChar(40)
 providerTransferId String? @db.VarChar(50)
 amountMinor BigInt?
 currency String? @db.VarChar(3)
 note String @db.VarChar(1500)
 checkedAt DateTime @default(now())
 attempt SupplierSettlementAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
 actor Account? @relation("SettlementCheckActor",fields:[actorId],references:[id],onDelete:SetNull)
 @@index([attemptId,checkedAt])
 @@map("supplier_settlement_reconciliations")
}


// Phase 15 — first-party transactional inbox and support. Email/SMS is explicitly not delivered.
enum NotificationCategory {
  PROCUREMENT
  FINANCE
  LOGISTICS
  SUPPORT
  SECURITY
}
enum OutboxDeliveryChannel {
  IN_APP
}
enum OutboxDeliveryStatus {
  DELIVERED
  SKIPPED
}
enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}
enum SupportCaseCategory {
  SOURCING
  PAYMENTS
  DELIVERY
  SUPPLIER_SETTLEMENT
  ACCOUNT
  OTHER
}

model OutboxEvent {
  id        String @id @default(uuid()) @db.Uuid
  eventKey  String @unique @db.VarChar(180)
  eventType String @db.VarChar(80)
  actorId   String? @db.Uuid
  subjectId String? @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())
  actor     Account? @relation("OutboxActor",fields:[actorId],references:[id],onDelete:SetNull)
  notifications Notification[]
  attempts  NotificationDeliveryAttempt[]
  @@index([eventType,createdAt])
  @@map("outbox_events")
}

model Notification {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @db.Uuid
  accountId  String @db.Uuid
  category   NotificationCategory
  title      String @db.VarChar(160)
  body       String @db.VarChar(1000)
  actionPath String @db.VarChar(400)
  readAt     DateTime?
  createdAt  DateTime @default(now())
  event      OutboxEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  account    Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@unique([eventId,accountId])
  @@index([accountId,readAt,createdAt])
  @@map("notifications")
}

model NotificationDeliveryAttempt {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @db.Uuid
  accountId  String @db.Uuid
  channel    OutboxDeliveryChannel @default(IN_APP)
  status     OutboxDeliveryStatus @default(DELIVERED)
  deliveredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  event      OutboxEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  account    Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@unique([eventId,accountId,channel])
  @@index([accountId,createdAt])
  @@map("notification_delivery_attempts")
}

model NotificationPreference {
  accountId   String @id @db.Uuid
  procurement Boolean @default(true)
  finance     Boolean @default(true)
  logistics   Boolean @default(true)
  support     Boolean @default(true)
  updatedAt   DateTime @updatedAt
  account     Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@map("notification_preferences")
}

model SupportCase {
  id           String @id @default(uuid()) @db.Uuid
  reference    String @unique @db.VarChar(40)
  clientKey    String @unique @db.Uuid
  openedById   String @db.Uuid
  assignedToId String? @db.Uuid
  category     SupportCaseCategory
  subject      String @db.VarChar(160)
  status       SupportCaseStatus @default(OPEN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?
  openedBy     Account @relation("SupportCaseOpener",fields:[openedById],references:[id],onDelete:Restrict)
  assignedTo   Account? @relation("SupportCaseAssignee",fields:[assignedToId],references:[id],onDelete:SetNull)
  messages     SupportMessage[]
  @@index([openedById,status,updatedAt])
  @@index([assignedToId,status,updatedAt])
  @@index([status,createdAt])
  @@map("support_cases")
}

model SupportMessage {
  id         String @id @default(uuid()) @db.Uuid
  caseId     String @db.Uuid
  clientKey  String @unique @db.Uuid
  authorId   String @db.Uuid
  body       String @db.VarChar(4000)
  internal   Boolean @default(false)
  createdAt  DateTime @default(now())
  case       SupportCase @relation(fields:[caseId],references:[id],onDelete:Restrict)
  author     Account @relation("SupportMessageAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  @@index([caseId,createdAt])
  @@map("support_messages")
}


// Phase 16 — auditable SUPER_ADMIN-only incident casework; never overrides source business states.
enum GovernanceIncidentCategory {
  ACCESS
  FINANCIAL_EXCEPTION
  SOURCING
  DELIVERY
  COMPLIANCE
  SYSTEM
}
enum GovernanceIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum GovernanceIncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  CLOSED
}
enum GovernanceSubjectType {
  ACCOUNT
  ORDER
  BUYER_PAYMENT
  SUPPLIER_OBLIGATION
  SHIPMENT
  SUPPORT_CASE
}

model GovernanceIncident {
  id           String @id @default(uuid()) @db.Uuid
  clientKey    String @unique @db.Uuid
  reference    String @unique @db.VarChar(40)
  category     GovernanceIncidentCategory
  severity     GovernanceIncidentSeverity
  status       GovernanceIncidentStatus @default(OPEN)
  version      Int @default(1)
  title        String @db.VarChar(180)
  description  String @db.VarChar(2000)
  subjectType  GovernanceSubjectType?
  subjectId    String? @db.Uuid
  openedById   String @db.Uuid
  assignedToId String? @db.Uuid
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  openedBy     Account @relation("IncidentOpener",fields:[openedById],references:[id],onDelete:Restrict)
  assignedTo   Account? @relation("IncidentAssignee",fields:[assignedToId],references:[id],onDelete:SetNull)
  events       GovernanceIncidentEvent[]
  @@index([status,severity,createdAt])
  @@index([subjectType,subjectId])
  @@map("governance_incidents")
}

model GovernanceIncidentEvent {
  id         String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  actorId    String @db.Uuid
  fromStatus GovernanceIncidentStatus?
  toStatus   GovernanceIncidentStatus
  reasonCode String @db.VarChar(60)
  note       String @db.VarChar(1500)
  createdAt  DateTime @default(now())
  incident   GovernanceIncident @relation(fields:[incidentId],references:[id],onDelete:Restrict)
  actor      Account @relation("IncidentEventActor",fields:[actorId],references:[id],onDelete:Restrict)
  @@index([incidentId,createdAt])
  @@map("governance_incident_events")
}
