generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  BUYER
  FARMER
  FIELD_AGENT
  OPERATIONS
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeletionStatus {
  REQUESTED
  UNDER_REVIEW
  DENIED
  COMPLETED
  CANCELLED
}

model Account {
  /// Matches auth.users.id. Authentication lives in Supabase Auth, not this table.
  id                 String           @id @db.Uuid
  role               AccountRole
  status             AccountStatus    @default(ACTIVE)
  email              String           @unique @db.VarChar(254)
  fullName           String           @db.VarChar(160)
  phone              String           @db.VarChar(20)
  phoneVerifiedAt    DateTime?
  pendingPhone       String?          @db.VarChar(20)
  farmName           String?          @db.VarChar(160)
  state              String?          @db.VarChar(60)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  phoneOtp           PhoneOtpThrottle?
  deletionRequests   DeletionRequest[]
  auditEvents        AuditEvent[]
  invitationsSent    StaffInvitation[] @relation("Inviter")
  farms              Farm[] @relation("FarmerFarms")
  farmerVerification FarmerVerification? @relation("FarmerVerificationOwner")
  verificationReviews FarmerVerification[] @relation("VerificationReviewer")
  crops              FarmerCrop[] @relation("FarmerCrops")
  supplies           SupplyDeclaration[] @relation("FarmerSupplies")
  supplyReviews      SupplyDeclaration[] @relation("SupplyReviewer")

  @@map("app_accounts")
}

// Server-issued public registration intent; never use untrusted Auth user metadata as a role claim.
model SignupIntent {
  id           String      @id @db.Uuid
  email        String      @db.VarChar(254)
  role         AccountRole
  fullName     String      @db.VarChar(160)
  phone        String      @db.VarChar(20)
  farmName     String?     @db.VarChar(160)
  state        String?     @db.VarChar(60)
  authUserId   String?     @unique @db.Uuid
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime    @default(now())
  @@index([email, expiresAt])
  @@map("signup_intents")
}

model PhoneOtpThrottle {
  accountId       String   @id @db.Uuid
  lastRequestedAt DateTime
  windowStartedAt DateTime
  countInWindow   Int      @default(1)
  attempts        Int      @default(0)
  lockedUntil     DateTime?
  targetPhone     String?  @db.VarChar(20)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("phone_otp_throttles")
}

model StaffInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @db.VarChar(254)
  role          AccountRole
  status        InvitationStatus @default(PENDING)
  invitedUserId String?          @unique @db.Uuid
  invitedById   String           @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?
  invitedBy     Account          @relation("Inviter", fields: [invitedById], references: [id])
  @@index([email, status])
  @@map("staff_invitations")
}

model DeletionRequest {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @db.Uuid
  status      DeletionStatus @default(REQUESTED)
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  account     Account        @relation(fields: [accountId], references: [id])
  @@index([accountId, status])
  @@map("account_deletion_requests")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      String   @db.VarChar(90)
  subjectId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  actor       Account  @relation(fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@map("auth_audit_events")
}

// Phase 2: Farmer onboarding, physical-supply declarations, and Operations review.
// No automated stock reservation or buyer publication is implied by APPROVED.
enum FarmerVerificationStatus {
  DRAFT
  PENDING_REVIEW
  MORE_INFO_REQUIRED
  VERIFIED
  REJECTED
}

enum CropStage {
  PLANNED
  GROWING
  HARVESTED
  INACTIVE
}

enum SupplyReviewStatus {
  DRAFT
  PENDING_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

model Commodity {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  slug            String?  @unique @db.VarChar(110)
  description     String?  @db.VarChar(1200)
  categoryId      String?  @db.Uuid
  publicPublished Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  category        CommodityCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  types           CommodityType[]
  specifications  CommoditySpecification[]
  crops           FarmerCrop[]
  supplies        SupplyDeclaration[]

  @@index([categoryId, publicPublished, active])
  @@map("commodities")
}

// Public catalog metadata, independent from stock/supplier data.
model CommodityCategory {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(90)
  name        String @unique @db.VarChar(100)
  description String? @db.VarChar(900)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  commodities Commodity[]

  @@map("commodity_categories")
}

model CommodityType {
  id              String @id @default(uuid()) @db.Uuid
  commodityId     String @db.Uuid
  slug            String @db.VarChar(110)
  name            String @db.VarChar(120)
  standardizedName String? @db.VarChar(120)
  marketName      String? @db.VarChar(120)
  description     String? @db.VarChar(900)
  publicPublished Boolean @default(false)
  createdAt       DateTime @default(now())
  commodity       Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@unique([commodityId, slug])
  @@map("commodity_types")
}

model CommoditySpecification {
  id              String @id @default(uuid()) @db.Uuid
  commodityId     String @db.Uuid
  name            String @db.VarChar(120)
  description     String? @db.VarChar(900)
  unit            String? @db.VarChar(40)
  publicPublished Boolean @default(false)
  createdAt       DateTime @default(now())
  commodity       Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@unique([commodityId, name])
  @@map("commodity_specifications")
}

model InsightArticle {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(140)
  title       String @db.VarChar(180)
  summary     String @db.VarChar(550)
  body        String @db.Text
  category    String @db.VarChar(80)
  published   Boolean @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
  @@map("insight_articles")
}

enum PublicEnquiryStatus {
  NEW
  IN_REVIEW
  CLOSED
}

model PublicEnquiry {
  id            String @id @default(uuid()) @db.Uuid
  fullName      String @db.VarChar(160)
  email         String @db.VarChar(254)
  phone         String? @db.VarChar(24)
  organisation  String? @db.VarChar(180)
  audience      String @db.VarChar(32)
  subject       String @db.VarChar(180)
  message       String @db.VarChar(4000)
  productSlug   String? @db.VarChar(110)
  senderHash    String @db.VarChar(64)
  status        PublicEnquiryStatus @default(NEW)
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([senderHash, createdAt])
  @@map("public_enquiries")
}

model PublicContactThrottle {
  senderHash String @id @db.VarChar(64)
  windowStart DateTime
  count Int @default(1)

  @@map("public_contact_throttles")
}

model Farm {
  id           String   @id @default(uuid()) @db.Uuid
  farmerId     String   @db.Uuid
  name         String   @db.VarChar(160)
  state        String   @db.VarChar(60)
  lga          String   @db.VarChar(120)
  community    String?  @db.VarChar(160)
  locationNote String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farmer       Account  @relation("FarmerFarms", fields: [farmerId], references: [id], onDelete: Restrict)
  crops        FarmerCrop[]
  supplies     SupplyDeclaration[]

  @@index([farmerId, createdAt])
  @@map("farms")
}

model FarmerVerification {
  id           String                   @id @default(uuid()) @db.Uuid
  farmerId     String                   @unique @db.Uuid
  status       FarmerVerificationStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?                  @db.Uuid
  feedback     String?                  @db.VarChar(2000)
  updatedAt    DateTime                 @updatedAt
  farmer       Account                  @relation("FarmerVerificationOwner", fields: [farmerId], references: [id], onDelete: Restrict)
  reviewer     Account?                 @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events       FarmerVerificationEvent[]

  @@index([status, submittedAt])
  @@map("farmer_verifications")
}

model FarmerVerificationEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  verificationId String                   @db.Uuid
  actorId        String                   @db.Uuid
  status         FarmerVerificationStatus
  note           String?                  @db.VarChar(2000)
  createdAt      DateTime                 @default(now())
  verification   FarmerVerification       @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  @@index([verificationId, createdAt])
  @@map("farmer_verification_events")
}

model FarmerCrop {
  id                String    @id @default(uuid()) @db.Uuid
  farmerId          String    @db.Uuid
  farmId            String    @db.Uuid
  commodityId       String    @db.Uuid
  variety           String?   @db.VarChar(120)
  stage             CropStage @default(GROWING)
  plantingDate      DateTime? @db.Date
  expectedHarvestAt DateTime? @db.Date
  estimatedQuantity Decimal?  @db.Decimal(18,3)
  estimatedUnit     String?   @db.VarChar(30)
  notes             String?   @db.VarChar(2000)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farmer            Account   @relation("FarmerCrops", fields: [farmerId], references: [id], onDelete: Restrict)
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict)
  commodity         Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  supplies          SupplyDeclaration[]

  @@index([farmerId, stage])
  @@index([farmId])
  @@map("farmer_crops")
}

model SupplyDeclaration {
  id                String             @id @default(uuid()) @db.Uuid
  farmerId          String             @db.Uuid
  farmId            String             @db.Uuid
  cropId            String?            @db.Uuid
  commodityId       String             @db.Uuid
  variety           String?            @db.VarChar(120)
  quantity          Decimal            @db.Decimal(18,3)
  unit              String             @db.VarChar(30)
  packaging         String?            @db.VarChar(160)
  harvestDate       DateTime?          @db.Date
  reportedCondition String             @db.VarChar(160)
  storageNote       String?            @db.VarChar(1000)
  notes             String?            @db.VarChar(2000)
  status            SupplyReviewStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?            @db.Uuid
  feedback          String?            @db.VarChar(2000)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  farmer            Account            @relation("FarmerSupplies", fields: [farmerId], references: [id], onDelete: Restrict)
  farm              Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  crop              FarmerCrop?        @relation(fields: [cropId], references: [id], onDelete: Restrict)
  commodity         Commodity          @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  reviewer          Account?           @relation("SupplyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events            SupplyReviewEvent[]

  @@index([farmerId, status, createdAt])
  @@index([status, submittedAt])
  @@map("supply_declarations")
}

model SupplyReviewEvent {
  id        String             @id @default(uuid()) @db.Uuid
  supplyId  String             @db.Uuid
  actorId   String             @db.Uuid
  status    SupplyReviewStatus
  note      String?            @db.VarChar(2000)
  createdAt DateTime           @default(now())
  supply    SupplyDeclaration  @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@index([supplyId, createdAt])
  @@map("supply_review_events")
}
