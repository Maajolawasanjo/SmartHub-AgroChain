generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  BUYER
  FARMER
  FIELD_AGENT
  OPERATIONS
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  DELIVERY_FAILED
  DELIVERY_UNCERTAIN
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeletionStatus {
  REQUESTED
  UNDER_REVIEW
  DENIED
  COMPLETED
  CANCELLED
}

model Account {
  /// Matches auth.users.id. Authentication lives in Supabase Auth, not this table.
  id                 String           @id @db.Uuid
  role               AccountRole
  status             AccountStatus    @default(ACTIVE)
  email              String           @unique @db.VarChar(254)
  fullName           String           @db.VarChar(160)
  phone              String           @db.VarChar(20)
  phoneVerifiedAt    DateTime?
  pendingPhone       String?          @db.VarChar(20)
  farmName           String?          @db.VarChar(160)
  state              String?          @db.VarChar(60)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  phoneOtp           PhoneOtpThrottle?
  deletionRequests   DeletionRequest[]
  auditEvents        AuditEvent[]
  invitationsSent    StaffInvitation[] @relation("Inviter")
  fieldAgentAssignments FieldAgentAssignment[] @relation("FieldAgentAssignments")
  assignmentsCreated FieldAgentAssignment[] @relation("AssignmentCreator")
  fieldVisitsAsAgent FieldVisit[] @relation("FieldVisitAgent")
  fieldVisitsAsFarmer FieldVisit[] @relation("FieldVisitFarmer")
  fieldVisitsReviewed FieldVisit[] @relation("FieldVisitReviewer")
  fieldVisitEvidenceUploads FieldVisitEvidence[] @relation("FieldVisitEvidenceUploader")
  fieldVisitEvents FieldVisitEvent[] @relation("FieldVisitEventActor")
  farms              Farm[] @relation("FarmerFarms")
  farmerVerification FarmerVerification? @relation("FarmerVerificationOwner")
  verificationReviews FarmerVerification[] @relation("VerificationReviewer")
  crops              FarmerCrop[] @relation("FarmerCrops")
  supplies           SupplyDeclaration[] @relation("FarmerSupplies")
  supplyReviews      SupplyDeclaration[] @relation("SupplyReviewer")
  operationsCasesAssigned OperationsReviewAssignment[] @relation("OperationsCaseAssignee")
  operationsCasesClaimed OperationsReviewAssignment[] @relation("OperationsCaseAssigner")
  supplyInspections SupplyInspectionAssessment[] @relation("SupplyInspectionReviewer")
  buyerMembership BuyerMembership?
  buyerSpecificationsCreated BuyerSavedSpecification[] @relation("BuyerSpecificationCreator")
  buyerVerificationEvents BuyerVerificationEvent[] @relation("BuyerVerificationEventActor")
  buyerRequestsCreated BuyerRequest[] @relation("BuyerRequestCreator")
  buyerRequestEvents BuyerRequestEvent[] @relation("BuyerRequestEventActor")
  buyerClarificationsAsked BuyerRequestClarification[] @relation("BuyerClarificationAsker")
  buyerClarificationsAnswered BuyerRequestClarification[] @relation("BuyerClarificationAnswerer")
  buyerRequestsAssigned BuyerRequestAssignment[] @relation("BuyerRequestAssignee")
  buyerRequestsAssignedBy BuyerRequestAssignment[] @relation("BuyerRequestAssigner")

  @@map("app_accounts")
}

// Server-issued public registration intent; email verification is required before provisioning.
// The intent is matched to the Auth user's confirmed email and is consumed once.
model SignupIntent {
  id           String      @id @db.Uuid
  email        String      @db.VarChar(254)
  role         AccountRole
  fullName     String      @db.VarChar(160)
  phone        String      @db.VarChar(20)
  farmName     String?     @db.VarChar(160)
  state        String?     @db.VarChar(60)
  authUserId   String?     @unique @db.Uuid
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime    @default(now())
  @@index([email, expiresAt])
  @@map("signup_intents")
}

model PhoneOtpThrottle {
  accountId       String   @id @db.Uuid
  lastRequestedAt DateTime
  windowStartedAt DateTime
  countInWindow   Int      @default(1)
  attempts        Int      @default(0)
  lockedUntil     DateTime?
  targetPhone     String?  @db.VarChar(20)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("phone_otp_throttles")
}

model StaffInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @db.VarChar(254)
  role          AccountRole
  status        InvitationStatus @default(PENDING)
  invitedUserId String?          @unique @db.Uuid
  invitedById   String           @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?
  invitedBy     Account          @relation("Inviter", fields: [invitedById], references: [id])
  @@index([email, status])
  @@index([status, expiresAt])
  @@map("staff_invitations")
}

model FieldAgentAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  fieldAgentId String   @db.Uuid
  state        String   @db.VarChar(60)
  active       Boolean  @default(true)
  assignedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fieldAgent   Account  @relation("FieldAgentAssignments", fields: [fieldAgentId], references: [id], onDelete: Restrict)
  assignedBy   Account  @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  @@unique([fieldAgentId, state])
  @@index([fieldAgentId, active])
  @@index([state, active])
  @@map("field_agent_assignments")
}


enum FieldVisitStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  RETURNED
  CANCELLED
}

enum FieldVisitPurpose {
  FARMER_VERIFICATION
  FARM_ASSESSMENT
  CROP_ASSESSMENT
  PRODUCTION_OBSERVATION
}

enum FieldVisitReviewDecision {
  ACCEPT_REPORT
  RETURN_FOR_CHANGES
}

enum FieldVisitEventType {
  CREATED
  STARTED
  UPDATED
  SUBMITTED
  ACCEPTED
  RETURNED
  CANCELLED
  EVIDENCE_ADDED
  EVIDENCE_REMOVED
}

enum FieldVisitEvidenceStatus {
  UPLOADING
  READY
  FAILED
  DELETING
}

model FieldVisit {
  id                       String                    @id @default(uuid()) @db.Uuid
  fieldAgentId             String                    @db.Uuid
  farmerId                 String                    @db.Uuid
  farmId                   String                    @db.Uuid
  purpose                  FieldVisitPurpose
  status                   FieldVisitStatus           @default(DRAFT)
  visitDate                DateTime                  @db.Date
  farmerPresent            Boolean?
  cropObservations         String?                   @db.VarChar(3000)
  productionObservations   String?                   @db.VarChar(3000)
  fieldNotes               String?                   @db.VarChar(5000)
  followUpRequired         Boolean                   @default(false)
  followUpNotes            String?                   @db.VarChar(2000)
  submittedAt              DateTime?
  reviewedAt               DateTime?
  reviewedById             String?                   @db.Uuid
  reviewDecision           FieldVisitReviewDecision?
  reviewerNote             String?                   @db.VarChar(2000)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  fieldAgent               Account                   @relation("FieldVisitAgent", fields: [fieldAgentId], references: [id], onDelete: Restrict)
  farmer                   Account                   @relation("FieldVisitFarmer", fields: [farmerId], references: [id], onDelete: Restrict)
  farm                     Farm                      @relation(fields: [farmId, farmerId], references: [id, farmerId], onDelete: Restrict)
  reviewer                 Account?                  @relation("FieldVisitReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence                 FieldVisitEvidence[]
  events                   FieldVisitEvent[]
  supplyAssessments        SupplyInspectionAssessment[]

  @@index([fieldAgentId, status, createdAt])
  @@index([farmerId, createdAt])
  @@index([farmId, createdAt])
  @@index([status, submittedAt])
  @@map("field_visits")
}

model FieldVisitEvidence {
  id           String                   @id @default(uuid()) @db.Uuid
  visitId      String                   @db.Uuid
  uploadedById String                   @db.Uuid
  objectPath   String                   @unique @db.VarChar(500)
  originalName String                   @db.VarChar(180)
  contentType  String                   @db.VarChar(80)
  sizeBytes    Int
  caption      String?                  @db.VarChar(500)
  status       FieldVisitEvidenceStatus  @default(UPLOADING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  visit        FieldVisit               @relation(fields: [visitId], references: [id], onDelete: Restrict)
  uploadedBy   Account                  @relation("FieldVisitEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([visitId, status, createdAt])
  @@map("field_visit_evidence")
}

model FieldVisitEvent {
  id        String               @id @default(uuid()) @db.Uuid
  visitId   String               @db.Uuid
  actorId   String               @db.Uuid
  eventType FieldVisitEventType
  status    FieldVisitStatus
  note      String?              @db.VarChar(2000)
  createdAt DateTime             @default(now())
  visit     FieldVisit           @relation(fields: [visitId], references: [id], onDelete: Restrict)
  actor     Account              @relation("FieldVisitEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([visitId, createdAt])
  @@index([actorId, createdAt])
  @@map("field_visit_events")
}

model DeletionRequest {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @db.Uuid
  status      DeletionStatus @default(REQUESTED)
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  account     Account        @relation(fields: [accountId], references: [id])
  @@index([accountId, status])
  @@map("account_deletion_requests")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      String   @db.VarChar(90)
  subjectId   String?  @db.Uuid
  details     Json?
  createdAt   DateTime @default(now())
  actor       Account  @relation(fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@map("auth_audit_events")
}

// Phase 2: Farmer onboarding, physical-supply declarations, and Operations review.
// No automated stock reservation or buyer publication is implied by APPROVED.
enum FarmerVerificationStatus {
  DRAFT
  PENDING_REVIEW
  MORE_INFO_REQUIRED
  VERIFIED
  REJECTED
}

enum CropStage {
  PLANNED
  GROWING
  HARVESTED
  INACTIVE
}

enum SupplyReviewStatus {
  DRAFT
  PENDING_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

model Commodity {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  slug            String?  @unique @db.VarChar(110)
  description     String?  @db.VarChar(1200)
  categoryId      String?  @db.Uuid
  publicPublished Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  category        CommodityCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  types           CommodityType[]
  specifications  CommoditySpecification[]
  crops           FarmerCrop[]
  supplies        SupplyDeclaration[]
  buyerSavedSpecifications BuyerSavedSpecification[]
  buyerRequestLines BuyerRequestLine[]

  @@index([categoryId, publicPublished, active])
  @@map("commodities")
}

// Public catalog metadata, independent from stock/supplier data.
model CommodityCategory {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(90)
  name        String @unique @db.VarChar(100)
  description String? @db.VarChar(900)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  commodities Commodity[]

  @@map("commodity_categories")
}

model CommodityType {
  id              String @id @default(uuid()) @db.Uuid
  commodityId     String @db.Uuid
  slug            String @db.VarChar(110)
  name            String @db.VarChar(120)
  standardizedName String? @db.VarChar(120)
  marketName      String? @db.VarChar(120)
  description     String? @db.VarChar(900)
  publicPublished Boolean @default(false)
  createdAt       DateTime @default(now())
  commodity       Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  buyerSavedSpecifications BuyerSavedSpecification[]
  buyerRequestLines BuyerRequestLine[]

  @@unique([commodityId, slug])
  @@map("commodity_types")
}

model CommoditySpecification {
  id              String @id @default(uuid()) @db.Uuid
  commodityId     String @db.Uuid
  name            String @db.VarChar(120)
  description     String? @db.VarChar(900)
  unit            String? @db.VarChar(40)
  publicPublished Boolean @default(false)
  createdAt       DateTime @default(now())
  commodity       Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  supplyAssessments SupplyInspectionAssessment[]
  buyerSavedSpecifications BuyerSavedSpecification[]
  buyerRequestLines BuyerRequestLine[]

  @@unique([commodityId, name])
  @@map("commodity_specifications")
}

model InsightArticle {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(140)
  title       String @db.VarChar(180)
  summary     String @db.VarChar(550)
  body        String @db.Text
  category    String @db.VarChar(80)
  published   Boolean @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
  @@map("insight_articles")
}

enum PublicEnquiryStatus {
  NEW
  IN_REVIEW
  CLOSED
}

model PublicEnquiry {
  id            String @id @default(uuid()) @db.Uuid
  fullName      String @db.VarChar(160)
  email         String @db.VarChar(254)
  phone         String? @db.VarChar(24)
  organisation  String? @db.VarChar(180)
  audience      String @db.VarChar(32)
  subject       String @db.VarChar(180)
  message       String @db.VarChar(4000)
  productSlug   String? @db.VarChar(110)
  senderHash    String @db.VarChar(64)
  status        PublicEnquiryStatus @default(NEW)
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([senderHash, createdAt])
  @@map("public_enquiries")
}

model PublicContactThrottle {
  senderHash String @id @db.VarChar(64)
  windowStart DateTime
  count Int @default(1)

  @@map("public_contact_throttles")
}

model Farm {
  id           String   @id @default(uuid()) @db.Uuid
  farmerId     String   @db.Uuid
  name         String   @db.VarChar(160)
  state        String   @db.VarChar(60)
  lga          String   @db.VarChar(120)
  community    String?  @db.VarChar(160)
  locationNote String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farmer       Account  @relation("FarmerFarms", fields: [farmerId], references: [id], onDelete: Restrict)
  crops        FarmerCrop[]
  supplies     SupplyDeclaration[]
  fieldVisits  FieldVisit[]

  @@unique([id, farmerId], map: "farms_id_farmerId_key")
  @@index([state, createdAt])
  @@index([farmerId, createdAt])
  @@map("farms")
}

model FarmerVerification {
  id           String                   @id @default(uuid()) @db.Uuid
  farmerId     String                   @unique @db.Uuid
  status       FarmerVerificationStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?                  @db.Uuid
  feedback     String?                  @db.VarChar(2000)
  updatedAt    DateTime                 @updatedAt
  farmer       Account                  @relation("FarmerVerificationOwner", fields: [farmerId], references: [id], onDelete: Restrict)
  reviewer     Account?                 @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events       FarmerVerificationEvent[]

  @@index([status, submittedAt])
  @@map("farmer_verifications")
}

model FarmerVerificationEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  verificationId String                   @db.Uuid
  actorId        String                   @db.Uuid
  status         FarmerVerificationStatus
  note           String?                  @db.VarChar(2000)
  createdAt      DateTime                 @default(now())
  verification   FarmerVerification       @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  @@index([verificationId, createdAt])
  @@map("farmer_verification_events")
}

model FarmerCrop {
  id                String    @id @default(uuid()) @db.Uuid
  farmerId          String    @db.Uuid
  farmId            String    @db.Uuid
  commodityId       String    @db.Uuid
  variety           String?   @db.VarChar(120)
  stage             CropStage @default(GROWING)
  plantingDate      DateTime? @db.Date
  expectedHarvestAt DateTime? @db.Date
  estimatedQuantity Decimal?  @db.Decimal(18,3)
  estimatedUnit     String?   @db.VarChar(30)
  notes             String?   @db.VarChar(2000)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farmer            Account   @relation("FarmerCrops", fields: [farmerId], references: [id], onDelete: Restrict)
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict)
  commodity         Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  supplies          SupplyDeclaration[]

  @@index([farmerId, stage])
  @@index([farmId])
  @@map("farmer_crops")
}

model SupplyDeclaration {
  id                String             @id @default(uuid()) @db.Uuid
  farmerId          String             @db.Uuid
  farmId            String             @db.Uuid
  cropId            String?            @db.Uuid
  commodityId       String             @db.Uuid
  variety           String?            @db.VarChar(120)
  quantity          Decimal            @db.Decimal(18,3)
  unit              String             @db.VarChar(30)
  packaging         String?            @db.VarChar(160)
  harvestDate       DateTime?          @db.Date
  reportedCondition String             @db.VarChar(160)
  storageNote       String?            @db.VarChar(1000)
  notes             String?            @db.VarChar(2000)
  status            SupplyReviewStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?            @db.Uuid
  feedback          String?            @db.VarChar(2000)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  farmer            Account            @relation("FarmerSupplies", fields: [farmerId], references: [id], onDelete: Restrict)
  farm              Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict)
  crop              FarmerCrop?        @relation(fields: [cropId], references: [id], onDelete: Restrict)
  commodity         Commodity          @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  reviewer          Account?           @relation("SupplyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events            SupplyReviewEvent[]
  qualityAssessments SupplyInspectionAssessment[]

  @@index([farmerId, status, createdAt])
  @@index([status, submittedAt])
  @@map("supply_declarations")
}

model SupplyReviewEvent {
  id        String             @id @default(uuid()) @db.Uuid
  supplyId  String             @db.Uuid
  actorId   String             @db.Uuid
  status    SupplyReviewStatus
  note      String?            @db.VarChar(2000)
  createdAt DateTime           @default(now())
  supply    SupplyDeclaration  @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@index([supplyId, createdAt])
  @@map("supply_review_events")
}

// Phase 07: one accountable reviewer per pending case, no self-approval.
enum OperationsReviewKind {
  FARMER_VERIFICATION
  SUPPLY_DECLARATION
}

model OperationsReviewAssignment {
  id           String @id @default(uuid()) @db.Uuid
  kind         OperationsReviewKind
  subjectId    String @db.Uuid
  assignedToId String @db.Uuid
  assignedById String @db.Uuid
  assignedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedTo   Account @relation("OperationsCaseAssignee",fields:[assignedToId],references:[id],onDelete:Restrict)
  assignedBy   Account @relation("OperationsCaseAssigner",fields:[assignedById],references:[id],onDelete:Restrict)

  @@unique([kind,subjectId])
  @@index([assignedToId,kind])
  @@map("operations_review_assignments")
}

// A recorded physical assessment is distinct from farmer-reported quantity and a stock reservation.
model SupplyInspectionAssessment {
  id               String @id @default(uuid()) @db.Uuid
  supplyId         String @db.Uuid
  reviewerId       String @db.Uuid
  evidenceVisitId  String @db.Uuid
  observedQuantity Decimal @db.Decimal(18,3)
  observedUnit     String @db.VarChar(30)
  conditionNote    String @db.VarChar(2000)
  specificationId  String? @db.Uuid
  createdAt        DateTime @default(now())
  supply           SupplyDeclaration @relation(fields:[supplyId],references:[id],onDelete:Restrict)
  reviewer         Account @relation("SupplyInspectionReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  evidenceVisit    FieldVisit @relation(fields:[evidenceVisitId],references:[id],onDelete:Restrict)
  specification    CommoditySpecification? @relation(fields:[specificationId],references:[id],onDelete:SetNull)

  @@index([supplyId,createdAt])
  @@index([evidenceVisitId])
  @@map("supply_inspection_assessments")
}

// Phase 08: business profile completion is distinct from independent verification.
enum BuyerBusinessType {
  REGISTERED_COMPANY
  SOLE_PROPRIETORSHIP
  COOPERATIVE
  PARTNERSHIP
  OTHER
}
enum BuyerContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}
enum BuyerMembershipRole {
  OWNER
  EDITOR
  VIEWER
}
enum BuyerVerificationStatus {
  NOT_REQUESTED
  PENDING_REVIEW
  MORE_INFO_REQUIRED
  VERIFIED
  REJECTED
}

model BuyerOrganization {
  id                     String @id @default(uuid()) @db.Uuid
  businessName           String? @db.VarChar(160)
  businessType           BuyerBusinessType?
  registrationNumber     String? @db.VarChar(80)
  contactName            String? @db.VarChar(160)
  contactEmail           String? @db.VarChar(254)
  contactPhone           String? @db.VarChar(24)
  state                  String? @db.VarChar(60)
  city                   String? @db.VarChar(120)
  addressLine            String? @db.VarChar(240)
  preferredContactMethod BuyerContactMethod @default(EMAIL)
  verificationStatus     BuyerVerificationStatus @default(NOT_REQUESTED)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  memberships            BuyerMembership[]
  destinations           BuyerDeliveryDestination[]
  savedSpecifications    BuyerSavedSpecification[]
  verificationEvents     BuyerVerificationEvent[]
  buyerRequests BuyerRequest[]

  @@map("buyer_organizations")
}

model BuyerMembership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  accountId      String @unique @db.Uuid
  role           BuyerMembershipRole @default(OWNER)
  joinedAt       DateTime @default(now())
  organization   BuyerOrganization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  account        Account @relation(fields:[accountId],references:[id],onDelete:Restrict)

  @@index([organizationId,role])
  @@map("buyer_memberships")
}

model BuyerDeliveryDestination {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  label          String @db.VarChar(80)
  state          String @db.VarChar(60)
  city           String @db.VarChar(120)
  addressLine    String @db.VarChar(240)
  contactName    String? @db.VarChar(160)
  contactPhone   String? @db.VarChar(24)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   BuyerOrganization @relation(fields:[organizationId],references:[id],onDelete:Restrict)

  @@index([organizationId,createdAt])
  @@map("buyer_delivery_destinations")
}

model BuyerSavedSpecification {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  createdById     String @db.Uuid
  commodityId     String @db.Uuid
  typeId          String? @db.Uuid
  specificationId String? @db.Uuid
  label           String @db.VarChar(120)
  quantity        Decimal @db.Decimal(18,3)
  unit            String @db.VarChar(30)
  deliveryState   String? @db.VarChar(60)
  notes           String? @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    BuyerOrganization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  createdBy       Account @relation("BuyerSpecificationCreator",fields:[createdById],references:[id],onDelete:Restrict)
  commodity       Commodity @relation(fields:[commodityId],references:[id],onDelete:Restrict)
  type            CommodityType? @relation(fields:[typeId],references:[id],onDelete:SetNull)
  specification   CommoditySpecification? @relation(fields:[specificationId],references:[id],onDelete:SetNull)

  @@index([organizationId,createdAt])
  @@map("buyer_saved_specifications")
}

model BuyerVerificationEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorId        String? @db.Uuid
  status         BuyerVerificationStatus
  note           String? @db.VarChar(2000)
  createdAt      DateTime @default(now())
  organization   BuyerOrganization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  actor          Account? @relation("BuyerVerificationEventActor",fields:[actorId],references:[id],onDelete:SetNull)

  @@index([organizationId,createdAt])
  @@map("buyer_verification_events")
}

enum BuyerRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  SOURCING_IN_PROGRESS
  CLOSED
  CANCELLED
}

enum BuyerFulfilmentMethod {
  SMARTHUB_DELIVERY
  BUYER_PICKUP
  THIRD_PARTY
}

enum BuyerRequestEventKind {
  CREATED
  DRAFT_UPDATED
  SUBMITTED
  REVIEW_STARTED
  CLARIFICATION_REQUESTED
  CLARIFICATION_ANSWERED
  SOURCING_STARTED
  CANCELLED
  CLOSED
}

model BuyerRequest {
  id                String @id @default(uuid()) @db.Uuid
  reference         String @unique @db.VarChar(40)
  clientRequestKey  String @db.Uuid
  clientRequestHash String @db.VarChar(64)
  organizationId    String @db.Uuid
  createdById       String @db.Uuid
  status            BuyerRequestStatus @default(DRAFT)
  version           Int @default(1)
  deliveryState     String? @db.VarChar(60)
  deliveryCity      String? @db.VarChar(120)
  deliveryAddress   String? @db.VarChar(240)
  requiredDate      DateTime? @db.Date
  fulfilmentMethod  BuyerFulfilmentMethod?
  notes             String? @db.VarChar(2000)
  draftPayload      Json?
  submittedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organization      BuyerOrganization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  createdBy         Account @relation("BuyerRequestCreator",fields:[createdById],references:[id],onDelete:Restrict)
  lines             BuyerRequestLine[]
  events            BuyerRequestEvent[]
  clarifications    BuyerRequestClarification[]
  assignment        BuyerRequestAssignment?

  @@unique([organizationId,clientRequestKey])
  @@index([organizationId,status,updatedAt])
  @@index([status,submittedAt])
  @@map("buyer_requests")
}

model BuyerRequestLine {
  id                String @id @default(uuid()) @db.Uuid
  requestId         String @db.Uuid
  position          Int
  commodityId       String? @db.Uuid
  commodityName     String @db.VarChar(120)
  typeId            String? @db.Uuid
  specificationId   String? @db.Uuid
  variety           String? @db.VarChar(120)
  quantity          Decimal @db.Decimal(18,3)
  unit              String @db.VarChar(30)
  quantityFlexible  Boolean @default(false)
  packaging         String? @db.VarChar(160)
  qualityNotes      String? @db.VarChar(1500)
  request           BuyerRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  commodity         Commodity? @relation(fields:[commodityId],references:[id],onDelete:Restrict)
  type              CommodityType? @relation(fields:[typeId],references:[id],onDelete:SetNull)
  specification     CommoditySpecification? @relation(fields:[specificationId],references:[id],onDelete:SetNull)

  @@unique([requestId,position])
  @@map("buyer_request_lines")
}

model BuyerRequestEvent {
  id          String @id @default(uuid()) @db.Uuid
  requestId   String @db.Uuid
  actorId     String @db.Uuid
  kind        BuyerRequestEventKind
  status      BuyerRequestStatus
  note        String? @db.VarChar(2000)
  createdAt   DateTime @default(now())
  request     BuyerRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  actor       Account @relation("BuyerRequestEventActor",fields:[actorId],references:[id],onDelete:Restrict)

  @@index([requestId,createdAt])
  @@map("buyer_request_events")
}

model BuyerRequestClarification {
  id           String @id @default(uuid()) @db.Uuid
  requestId    String @db.Uuid
  askedById    String @db.Uuid
  question     String @db.VarChar(2000)
  answer       String? @db.VarChar(2000)
  answeredById String? @db.Uuid
  askedAt      DateTime @default(now())
  answeredAt   DateTime?
  request      BuyerRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  askedBy      Account @relation("BuyerClarificationAsker",fields:[askedById],references:[id],onDelete:Restrict)
  answeredBy   Account? @relation("BuyerClarificationAnswerer",fields:[answeredById],references:[id],onDelete:SetNull)

  @@index([requestId,askedAt])
  @@map("buyer_request_clarifications")
}

model BuyerRequestAssignment {
  id           String @id @default(uuid()) @db.Uuid
  requestId    String @unique @db.Uuid
  assignedToId String @db.Uuid
  assignedById String @db.Uuid
  assignedAt   DateTime @default(now())
  dueAt        DateTime?
  request      BuyerRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  assignedTo   Account @relation("BuyerRequestAssignee",fields:[assignedToId],references:[id],onDelete:Restrict)
  assignedBy   Account @relation("BuyerRequestAssigner",fields:[assignedById],references:[id],onDelete:Restrict)

  @@index([assignedToId])
  @@map("buyer_request_assignments")
}
