# PUBLIC: Supabase project URL and publishable key (not a service secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The production Supabase project reference is a 20-character non-secret identifier.
# Set a DIFFERENT staging ref only in the isolated staging environment.
SMART_HUB_PRODUCTION_SUPABASE_REF=
SMART_HUB_STAGE_SUPABASE_REF=
# Serverless Prisma pool size per warm function instance (1-10, default 3).
SMART_HUB_DB_POOL_MAX=3
# The private readiness route is for approved staging only, never production.
RELEASE_ACCEPTANCE_ENABLED=false

# PRIVATE: Runtime Supabase transaction pooler, usually port 6543.
# Include ?sslmode=require; percent-encode special characters in passwords.
# The Prisma ORM must never use an unrelated Prisma/Vercel Postgres database.
# PRIVATE: runtime PostgreSQL URI; for Prisma. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=
# PRIVATE: migration connection. Use direct 5432 (IPv6) or Supavisor session 5432 (IPv4); NEVER transaction port 6543.
DIRECT_URL=
# The real browser-visible site origin. HTTPS is required in production.
APP_BASE_URL=http://localhost:3000
# Keep CLOSED until legal policy and provider requirements are approved.
PUBLIC_SIGNUP_ENABLED=false
# PRIVATE: random secret >=32 characters for recovery callback tickets.
AUTH_RECOVERY_SECRET=
# PRIVATE: only needed for restricted Super Admin invitations.
SUPABASE_SECRET_KEY=
# Public contact requires approved privacy terms, a DB, and a verified anti-bot provider.
PUBLIC_CONTACT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC key (32+ random chars), never exposed to browser or checked into source.
CONTACT_HASH_SECRET=

# PHASE 12: private Paystack keys. Keep checkout disabled until commercial/legal approval and staging verification.
# Only set PAYMENTS_ENABLED=true after real merchant configuration, policies and provider-backed staging tests pass.
PAYMENTS_ENABLED=false
# Separate explicit opt-in for live Paystack transactions; staging MUST leave false.
# Live mode also requires NODE_ENV=production and APP_BASE_URL exactly matching PRODUCTION_BASE_URL (HTTPS).
PAYSTACK_LIVE_ENABLED=false
PRODUCTION_BASE_URL=
PAYSTACK_SECRET_KEY=
# Preferred modern Paystack-Signature signing secret (whsec_*). Legacy x-paystack-signature uses the API secret.
PAYSTACK_WEBHOOK_SECRET=
# Phase 14: payout execution is strictly disabled until bank identity verification,
# documented seller-of-record/fees policy, independent approvals and staging transfer tests.
SUPPLIER_PAYOUTS_ENABLED=false
# Server-only 32-byte AES-256-GCM encryption key encoded as Base64; use a secure KMS/secret store.
# Changing this key without re-encrypting existing records will make payout accounts unreadable.
FARMER_BANK_ENCRYPTION_KEY=
# Set a separate HTTPS webhook endpoint in the Paystack dashboard:
# https://YOUR_ORIGIN/api/payments/paystack/webhook
# Never put Paystack secret keys in NEXT_PUBLIC_* variables or send them to the frontend.

# Private Supabase Storage bucket for field-visit evidence (created by the Phase 05 migration).
FIELD_EVIDENCE_BUCKET=field-visit-evidence
# Phase 13: private, server-owned proof-of-pickup, delivery and receipt evidence bucket.
# Created by the Phase 13 SQL migration; keep public=false and no blanket Storage policies.
SHIPMENT_EVIDENCE_BUCKET=shipment-evidence
