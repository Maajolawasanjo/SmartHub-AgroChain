# PUBLIC: Supabase project URL and publishable key (not a service secret).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PRIVATE: runtime PostgreSQL URI; for Prisma. Never expose as NEXT_PUBLIC_*.
DATABASE_URL=
# PRIVATE: migration connection. Use directly connected / approved migration role.
DIRECT_URL=
# The real browser-visible site origin. HTTPS is required in production.
APP_BASE_URL=http://localhost:3000
# Keep CLOSED until legal policy and provider requirements are approved.
PUBLIC_SIGNUP_ENABLED=false
# PRIVATE: random secret >=32 characters for recovery callback tickets.
AUTH_RECOVERY_SECRET=
# PRIVATE: only needed for restricted Super Admin invitations.
SUPABASE_SECRET_KEY=
# Public contact requires approved privacy terms, a DB, and a verified anti-bot provider.
PUBLIC_CONTACT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC key (32+ random chars), never exposed to browser or checked into source.
CONTACT_HASH_SECRET=

# Private Supabase Storage bucket for field-visit evidence (created by the Phase 05 migration).
FIELD_EVIDENCE_BUCKET=field-visit-evidence
